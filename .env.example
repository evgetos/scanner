# Copy this file to `.env` next to run.py and fill in your values.
# `.env` is gitignored, so keys never end up in the repo.
# All variables are optional — without them the scanner still works,
# only the D/W status for the corresponding exchange will be shown as `?`.

# --- Exchange API keys (only Read / View permissions) ---
MEXC_API_KEY=
MEXC_SECRET_KEY=
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BYBIT_API_KEY=
BYBIT_SECRET_KEY=

# --- Network / scanner tuning ---
# SCANNER_PROXY=socks5://user:pass@host:1080
# SCANNER_MIN_VOLUME=200000
# SCANNER_MIN_SPREAD=0.5
# SCANNER_MAX_SPREAD=20
# SCANNER_OB_LIMIT=50
# SCANNER_REFRESH_INTERVAL=60
# SCANNER_AUTO_START=1
# SCANNER_ARBITRAGE_LIMIT=50
# SCANNER_HISTORY_LIMIT=1000        # In-memory ring-buffer size for Stats tab
# SCANNER_HISTORY_FILE=./data/scanner_history.jsonl   # set to empty to disable persistence

# --- Telegram notifications (optional) ---
# Token from @BotFather and chat / channel id where new arbitrage situations
# (those that pass the Stats-tab filters) will be posted as one message per scan.
# Leave empty to disable notifications.
# TELEGRAM_BOT_TOKEN=123456:ABC-def...
# TELEGRAM_CHAT_ID=123456789           # personal chat, or -1001234567890 for channel
# TELEGRAM_ENABLED=1                   # 0 disables sending even if token/chat_id are set

# --- run.py knobs ---
# SCANNER_HOST=127.0.0.1
# SCANNER_PORT=8000
# SCANNER_RELOAD=1
