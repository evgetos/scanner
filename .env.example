# Опциональные ключи MEXC API (только READ).
# Нужны только для получения статусов депозита/вывода и адресов контрактов
# по сетям (эндпоинт /api/v3/capital/config/getall требует подписи).
# Если не задать — приложение всё равно работает, но для этих полей будет "N/A".
MEXC_API_KEY=
MEXC_API_SECRET=

# Адрес/порт HTTP-сервера (опционально).
HOST=0.0.0.0
PORT=8000

# Время жизни кэша в секундах (опционально).
CACHE_TTL=30
